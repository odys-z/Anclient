# Link file: folder deps (e.g. @anclient/semantier -> ../../../js/semantier)
# as symlinks on every machine, whatever the npm version's default.
# npm 9.0-9.3 defaulted install-links=true (copy), later npm uses false (link);
# mixing them made package-lock.json add/drop the "../../../js/semantier" entry.
install-links=false
