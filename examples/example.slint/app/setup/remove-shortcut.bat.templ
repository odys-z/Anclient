<# : batch part, ASCII only. PowerShell reads this file as UTF-8 and runs the part after it.
@echo off
rem Generated by tasks.py shallow-pack from app/setup/remove-shortcut.bat.templ. Don't edit.
rem
rem Remove the shortcuts create-shortcut.bat created, the ones targeting this folder's @@EXE@@.exe
rem (or the synode's setup-gui), whatever their names are now:
rem   stand alone package: the Desktop icon;
rem   with a synode (called by uninstall-srv with PORTFOLIO_SYNODE=<synode-id>):
rem     Start Menu\Programs\<root>\<synode-id>\, then <root>\ if it's left empty.
rem Usage: remove-shortcut.bat [/q]    /q: don't pause
setlocal
set "PORTFOLIO_SCRIPT=%~f0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "iex ([IO.File]::ReadAllText($env:PORTFOLIO_SCRIPT, [Text.Encoding]::UTF8))"
set "err=%errorlevel%"
if /i not "%~1"=="/q" pause
exit /b %err%
#>

$ErrorActionPreference = 'Stop'
[Console]::OutputEncoding = New-Object Text.UTF8Encoding $false

$root = '@@ROOT@@'
$here = Split-Path -Parent $env:PORTFOLIO_SCRIPT
$exe  = Join-Path $here '@@EXE@@.exe'

function Get-ValidName([string]$n) { ($n -replace '[\\/:*?"<>|\x00-\x1f]', '_').Trim().TrimEnd('.') }

# Remove the .lnk files in $dir whose target is accepted by $mine.
function Remove-Links([string]$dir, [scriptblock]$mine) {
    if (-not (Test-Path -LiteralPath $dir)) { return }
    $w = New-Object -ComObject WScript.Shell
    foreach ($f in Get-ChildItem -LiteralPath $dir -Filter '*.lnk' -File) {
        if (& $mine $w.CreateShortcut($f.FullName).TargetPath) {
            Remove-Item -LiteralPath $f.FullName -Force
            Write-Output "Shortcut removed: $($f.FullName)"
        }
    }
}

function Remove-IfEmpty([string]$dir) {
    if ((Test-Path -LiteralPath $dir) -and -not (Get-ChildItem -LiteralPath $dir -Force)) {
        Remove-Item -LiteralPath $dir -Force
    }
}

try {
    if ([string]::IsNullOrWhiteSpace($env:PORTFOLIO_SYNODE)) {
        Remove-Links ([Environment]::GetFolderPath('Desktop')) { param($t) $t -ieq $exe }
    }
    else {
        $install = Split-Path -Parent $here
        $rootdir = Join-Path ([Environment]::GetFolderPath('Programs')) $root
        $dir = Join-Path $rootdir (Get-ValidName $env:PORTFOLIO_SYNODE)
        $prefix = $install.TrimEnd('\') + '\'
        Remove-Links $dir { param($t) $t.StartsWith($prefix, [StringComparison]::OrdinalIgnoreCase) }
        Remove-IfEmpty $dir
        Remove-IfEmpty $rootdir
    }
}
catch {
    Write-Output "Removing the shortcut failed: $_"
    exit 1
}
exit 0
