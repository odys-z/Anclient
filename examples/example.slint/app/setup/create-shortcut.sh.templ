#!/bin/sh
# Generated by tasks.py shallow-pack from app/setup/create-shortcut.sh.templ. Don't edit.
#
# Create the Portfolio Desktop launcher, starting @@EXE@@ in this script's folder (Path=), where it
# reads settings/app-settings.json:
#   stand alone package (the unzipped folder): a Desktop icon;
#   with a synode (<installation>/desktop, called by setup-cli with PORTFOLIO_SYNODE=<synode-id>, and
#   PORTFOLIO_VENV=<venv> if it runs in one): the applications menu's "<desktop> (<synode-id>)" and
#   "<setup> (<synode-id>)", the latter running ./synode-cli in a terminal in <installation>.
# Usage: sh create-shortcut.sh

deskname='@@DESKTOP@@'
setupname='@@SETUP@@'
here=$(cd "$(dirname "$0")" && pwd) || exit 1
exe="$here/@@EXE@@"

# The general escape of string values (Name, Path), .desktop specification.
desk_str() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' | tr '\n\r\t' '   '; }
# A quoted argument of Exec: the quoting escape, then the general escape, and %.
desk_arg() { printf '"%s"' "$(printf '%s' "$1" | sed -e 's/[\\"`$]/\\&/g' -e 's/\\/\\\\/g' -e 's/%/%%/g')"; }
# A file name part from the synode id.
file_part() { printf '%s' "$1" | tr '/ \t\n' '____'; }
# Single-quoted for sh.
sh_quote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# write_entry <file> <name> <path> <exec> <terminal>
write_entry() {
    cat > "$1" <<ENTRY || return 1
[Desktop Entry]
Type=Application
Name=$(desk_str "$2")
Path=$(desk_str "$3")
Exec=$4
Terminal=$5
Categories=Utility;
ENTRY
    chmod +x "$1" && echo "Shortcut created: $1"
}

if [ ! -x "$exe" ]; then
    echo "Not found: $exe" >&2
    exit 1
fi

if [ -z "$PORTFOLIO_SYNODE" ]; then
    desk=$(xdg-user-dir DESKTOP 2>/dev/null)
    [ -n "$desk" ] || desk="$HOME/Desktop"
    mkdir -p "$desk" || exit 1
    f="$desk/portfolio-desktop.desktop"
    write_entry "$f" "$deskname" "$here" "$(desk_arg "$exe")" false || exit 1
    # GNOME: let the Desktop icon launch without the "untrusted launcher" prompt
    gio set "$f" metadata::trusted true 2>/dev/null || true
else
    install=$(dirname "$here")
    apps="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    mkdir -p "$apps" || exit 1
    id=$(file_part "$PORTFOLIO_SYNODE")
    write_entry "$apps/portfolio-$id-desktop.desktop" "$deskname ($PORTFOLIO_SYNODE)" "$here" \
                "$(desk_arg "$exe")" false || exit 1

    act=''
    if [ -n "$PORTFOLIO_VENV" ] && [ -f "$PORTFOLIO_VENV/bin/activate" ]; then
        act=". $(sh_quote "$PORTFOLIO_VENV/bin/activate"); "
    fi
    cli="${act}if [ -x ./synode-cli ]; then ./synode-cli; else synode-cli; fi; exec \"\${SHELL:-sh}\""
    write_entry "$apps/portfolio-$id-setup.desktop" "$setupname ($PORTFOLIO_SYNODE)" "$install" \
                "sh -c $(desk_arg "$cli")" true || exit 1
fi
exit 0
