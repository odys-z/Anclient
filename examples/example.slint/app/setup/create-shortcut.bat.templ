<# : batch part, ASCII only. PowerShell reads this file as UTF-8 and runs the part after it.
@echo off
rem Generated by tasks.py shallow-pack from app/setup/create-shortcut.bat.templ. Don't edit.
rem
rem Create the Portfolio Desktop shortcut, starting @@EXE@@.exe in this script's folder, where it
rem reads settings/app-settings.json:
rem   stand alone package (the unzipped folder): a Desktop icon;
rem   with a synode (<installation>\desktop, called by setup-cli/gui with PORTFOLIO_SYNODE=<synode-id>):
rem     Start Menu\Programs\<root>\<synode-id>\, the desktop and setup-gui.
rem Usage: create-shortcut.bat [/q]    /q: don't pause
setlocal
set "PORTFOLIO_SCRIPT=%~f0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "iex ([IO.File]::ReadAllText($env:PORTFOLIO_SCRIPT, [Text.Encoding]::UTF8))"
set "err=%errorlevel%"
if /i not "%~1"=="/q" pause
exit /b %err%
#>

$ErrorActionPreference = 'Stop'
[Console]::OutputEncoding = New-Object Text.UTF8Encoding $false

$root      = '@@ROOT@@'
$deskname  = '@@DESKTOP@@'
$setupname = '@@SETUP@@'
$here      = Split-Path -Parent $env:PORTFOLIO_SCRIPT
$exe       = Join-Path $here '@@EXE@@.exe'

function Get-ValidName([string]$n) { ($n -replace '[\\/:*?"<>|\x00-\x1f]', '_').Trim().TrimEnd('.') }

function New-Link([string]$lnk, [string]$target, [string]$workdir) {
    $s = (New-Object -ComObject WScript.Shell).CreateShortcut($lnk)
    $s.TargetPath = $target
    $s.WorkingDirectory = $workdir
    $s.Save()
    Write-Output "Shortcut created: $lnk"
}

try {
    if (-not (Test-Path -LiteralPath $exe)) { throw "Not found: $exe" }

    if ([string]::IsNullOrWhiteSpace($env:PORTFOLIO_SYNODE)) {
        New-Link (Join-Path ([Environment]::GetFolderPath('Desktop')) "$deskname.lnk") $exe $here
    }
    else {
        $install = Split-Path -Parent $here
        $dir = Join-Path (Join-Path ([Environment]::GetFolderPath('Programs')) $root) (Get-ValidName $env:PORTFOLIO_SYNODE)
        [void][IO.Directory]::CreateDirectory($dir)
        New-Link (Join-Path $dir "$deskname.lnk") $exe $here

        $setup = Join-Path $install '@@SETUP_EXE@@'
        if (Test-Path -LiteralPath $setup) { New-Link (Join-Path $dir "$setupname.lnk") $setup $install }
        else { Write-Output "Not found, no shortcut for it: $setup" }
    }
}
catch {
    Write-Output "Creating the shortcut failed: $_"
    exit 1
}
exit 0
