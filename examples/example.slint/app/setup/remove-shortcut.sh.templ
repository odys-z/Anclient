#!/bin/sh
# Generated by tasks.py shallow-pack from app/setup/remove-shortcut.sh.templ. Don't edit.
#
# Remove the launchers create-shortcut.sh created for this folder (their Path= is this folder, or
# for the setup entry, the synode's installation):
#   stand alone package: the Desktop icon;
#   with a synode (called by uninstall-srv with PORTFOLIO_SYNODE=<synode-id>): the applications menu's.
# Usage: sh remove-shortcut.sh

here=$(cd "$(dirname "$0")" && pwd) || exit 1

desk_str() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' | tr '\n\r\t' '   '; }
file_part() { printf '%s' "$1" | tr '/ \t\n' '____'; }

# remove_if <file> <path>: remove the launcher if its Path= is <path>
remove_if() {
    [ -f "$1" ] || return 0
    if grep -qxF "Path=$(desk_str "$2")" "$1"; then
        rm -f "$1" && echo "Shortcut removed: $1"
    else
        echo "Not removed, it's not for $2: $1"
    fi
}

if [ -z "$PORTFOLIO_SYNODE" ]; then
    desk=$(xdg-user-dir DESKTOP 2>/dev/null)
    [ -n "$desk" ] || desk="$HOME/Desktop"
    remove_if "$desk/portfolio-desktop.desktop" "$here"
else
    apps="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    id=$(file_part "$PORTFOLIO_SYNODE")
    remove_if "$apps/portfolio-$id-desktop.desktop" "$here"
    remove_if "$apps/portfolio-$id-setup.desktop" "$(dirname "$here")"
fi
exit 0
