import { SMenu, SCard, SHeader, SIcon, SButton, STip, STag, SPopup } from "@surrealism/index.slint";
import { UseIcons } from "@surrealism/use/index.slint";
import { LineEdit, ComboBox, VerticalBox } from "std-widgets.slint";


export struct UserProfileModel {
    info_label: string,
    detail_label: string,

    market_name: string,
    readonly_url_text: string,

    orgs_model: [string],
    domains_model: [string],
    synodes_model: [string],
    selected_org: string,
    selected_domain: string,
    selected_node: string,

    url_text: string,
    user_id_text: string,
    password_text: string,
    confirm_password_text: string,

    // Set by the host code after a successful login test, e.g.
    // let mut m = ui.get_model();
    // m.qr_code_image = Image::load_from_path(...);
    // m.show_qr_code = true;
    // ui.set_model(m);
    qr_code_image: image,
    show_qr_code: bool,
}

export component UserProfile {
    in-out property <UserProfileModel> model: {
        info_label: "Portfolio Desktop 0.1.0",
        detail_label: "Product page: ...",
        market_name: "MY 0.1.0",
        orgs_model: ["Test-1", "Test-2"],
        domains_model: ["Test-1:domain 0", "Test-1: domain 1"],
        synodes_model: ["domain 0-hub", "domain 1-1"],
        show_qr_code: false,
    };

    // Fired once, with the full model, any time the UI mutates a field
    // below. Host code only needs to subscribe here instead of tracking
    // each field individually.
    callback model-changed(UserProfileModel);

    callback refresh-clicked();
    callback org-domain-node-changed(string, string, string);
    callback ping-clicked(string);
    callback login-test-clicked(string, string);
    callback save-clicked(string, string, string, string);

    function notify-changed() {
        root.model-changed(root.model);
    }

    Rectangle {
        height: 100%;
        width: 100%;
        vertical-stretch: 1;
        background: #1f1f14;

        Image {
            width: 100%;
            height: 100%;
            source: @image-url("imgs/album.svg");
            image-fit: cover; // fills as much area as possible while preserving aspect ratio
            opacity: 0.16;
        }

        VerticalLayout {
            alignment: center;
            padding: 8pt;
            VerticalLayout {
                padding-bottom: 26pt; 
                horizontal-stretch: 1;
                alignment: center;
                Text { text: root.model.info_label; font-size: 18pt; color: #ccc; }
                Text { text: root.model.detail_label; font-size: 14pt; color: #ccc; }
            }

            GridLayout {
                spacing: 8pt;

                // market name
                Row {
                  HorizontalLayout {
                    spacing: 8pt;
                    Text { text: "Market ID  : "; font-size: 14pt; color: #bbb; }
                    Rectangle {
                        background: #8a8a8a;
                        border-radius: 4px;
                        LineEdit {
                            width: 100%;
                            horizontal-stretch: 1;
                            read-only: true;
                            text: root.model.market_name;
                            font-size: 16pt;
                            horizontal-alignment: center;
                        }
                    }
                  }
                }

                // Registry Jserv
                Row {
                    LineEdit {
                        col: 0;
                        horizontal-stretch: 1;
                        read-only: true;
                        text: root.model.readonly_url_text;
                    }

                    SButton {
                        col: 1;
                        horizontal-stretch: 0;
                        width: 96px;
                        show-icon: true;
                        icon: @image-url("imgs/refresh.svg");
                        text: @tr("Refresh");
                        clicked => {
                            refresh-clicked();
                        }
                    }
                }

                // orgs | domain | synode
                Row {
                    HorizontalLayout {
                        col: 0;
                        spacing: 8px;

                        orgs-combo := ComboBox {
                            horizontal-stretch: 1;
                            model: root.model.orgs_model;
                            current-value: root.model.selected_org;
                            selected(value) => {
                                root.model.selected_org = value;
                                root.notify-changed();
                                org-domain-node-changed(root.model.selected_org, root.model.selected_domain, root.model.selected_node);
                            }
                        }

                        domain-combo := ComboBox {
                            horizontal-stretch: 1;
                            model: root.model.domains_model;
                            current-value: root.model.selected_domain;
                            selected(value) => {
                                root.model.selected_domain = value;
                                root.notify-changed();
                                org-domain-node-changed(root.model.selected_org, root.model.selected_domain, root.model.selected_node);
                            }
                        }

                        node-combo := ComboBox {
                            horizontal-stretch: 1;
                            model: root.model.synodes_model;
                            current-value: root.model.selected_node;
                            selected(value) => {
                                root.model.selected_node = value;
                                root.notify-changed();
                                org-domain-node-changed(root.model.selected_org, root.model.selected_domain, root.model.selected_node);
                            }
                        }
                    }
                }

                // jserv-url | Ping
                Row {
                    url-edit := LineEdit {
                        col: 0;
                        horizontal-stretch: 1;
                        placeholder-text: @tr("Server URL");
                        text: root.model.url_text;
                        edited(text) => {
                            root.model.url_text = text;
                            root.notify-changed();
                        }
                    }

                    SButton {
                        col: 1;
                        horizontal-stretch: 0;
                        width: 96px;
                        show-icon: true;
                        icon: UseIcons.icons.Info;
                        text: @tr("    Ping");
                        clicked => {
                            ping-clicked(url-edit.text);
                        }
                    }
                }

                // [ uid ]   [ pswd | pswd-2 ] | Login  (single flat row, flows horizontally)
                Row {
                    HorizontalLayout {
                        col: 0;
                        spacing: 8px;

                        user-id-edit := LineEdit {
                            horizontal-stretch: 1;
                            placeholder-text: @tr("User ID");
                            text: root.model.user_id_text;
                            edited(text) => {
                                root.model.user_id_text = text;
                                root.notify-changed();
                            }
                        }

                        // spacer to visually separate uid from the pswd/pswd-2 pair
                        Rectangle {
                            width: 16px;
                        }

                        password-edit := LineEdit {
                            horizontal-stretch: 1;
                            placeholder-text: @tr("Password");
                            input-type: password;
                            text: root.model.password_text;
                            edited(text) => {
                                root.model.password_text = text;
                                root.notify-changed();
                            }
                        }

                        confirm-password-edit := LineEdit {
                            horizontal-stretch: 1;
                            placeholder-text: @tr("Confirm");
                            input-type: password;
                            text: root.model.confirm_password_text;
                            edited(text) => {
                                root.model.confirm_password_text = text;
                                root.notify-changed();
                            }
                        }
                    }

                    SButton {
                        col: 1;
                        horizontal-stretch: 0;
                        width: 96px;
                        text: "Login";
                        clicked => {
                            login-test-clicked(user-id-edit.text, password-edit.text);
                        }
                    }
                }

                // QR code (centered) | Save
                Row {
                    Rectangle {
                        col: 0;
                        height: 160px;

                        HorizontalLayout {
                            alignment: center;

                            if root.model.show_qr_code: Image {
                                width: 160px;
                                height: 160px;
                                source: root.model.qr_code_image;
                            }
                            if !root.model.show_qr_code: Rectangle {
                                width: 160px;
                                height: 160px;
                                background: #00000022;
                                border-width: 1px;
                                border-color: #ffffff55;

                                Text {
                                    text: @tr("QR");
                                    color: #ffffff88;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    SButton {
                        col: 1;
                        horizontal-stretch: 0;
                        width: 96px;
                        show-icon: true;
                        icon: @image-url("imgs/save.svg");
                        theme: Primary;
                        text: "Save";
                        clicked => {
                            save-clicked(url-edit.text, user-id-edit.text, password-edit.text, confirm-password-edit.text);
                        }
                    }
                }
            }
        }
    }
}
