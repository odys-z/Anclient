import { SMenu, SCard, SHeader, SIcon, SButton, SPopup, STag } from "@surrealism/index.slint";
import { UseIcons } from "@surrealism/use/index.slint";

import { TableViewPage } from "./table_view_page.slint";
import { CustomTableViewPage } from "./custom-table.slint";
import { HomeForm } from "home.slint";
import { EdgeHealth } from "edge-health.slint";
import { PathItemData, FileTable } from "file-table.slint";
import { UserProfile } from "user.slint";
import { AppState } from "app-state.slint";

export { AppState } from "app-state.slint";

export component App inherits Window {

/* To enable slint preview, use this:
 */
height: 600px;
width: 1024px;

/* To enable maximize, use this:
preferred-height: 600px;
preferred-width:  1024px;
min-height: 400px;
min-width: 600px;
 */

  title: AppState.data.window_title;

  // Pure UI-computed outputs (window geometry read by the host) —
  // not part of AppState since the host only ever reads these, never sets them.
  out property <length> web_x;
  out property <length> web_y;
  out property <length> web_width;
  out property <length> web_height;

  // Design Notes:
  // Gemini says the callback cannot be reached because the callback hasn't been set by ui->on_initapp() yet.
  // callback initapp();

  callback menu-changed(string);
  callback item_clicked(string, bool);
  callback echows(string);
  callback pingws([string]);
  callback load_folder(string);
  callback query_syncflags();
  callback update_syncflags();
  callback select_file(PathItemData, bool);
  callback upload_files();
  callback open_web(string);
  callback open_volume();
  // callback update_synlink(bool);

  function notify-changed() {
      AppState.data-changed(AppState.data);
  }

  init => { }

  HorizontalLayout {
    left-wrapper:=Rectangle {
      z: 111;
      width: menu.width;
      clip: false;
      menu:=SMenu {
        menu-data:[
          { id: "home",  icon: @image-url("imgs/home.svg"),  name: "Home" },
          { id: "album", icon: @image-url("imgs/album-icon.svg"), name: "Album"},
          { id: "volume",icon: UseIcons.icons.Folder,   name: "Volume" },
          { id: "upload",icon: UseIcons.icons.FileCode, name: "Upload" },
        ];

        change(index, data) => {
          debug(index, data);
          AppState.data.menu_id = data.id;
          root.notify-changed();
          menu-changed(data.id);
        }
      }
    }

    right-wrapper:=Rectangle {
      z: 100;
      width: parent.width - menu.width;
      background: #2b2b32;
      VerticalLayout {
        width: parent.width;
        height: parent.height;

        // if (AppState.data.menu_id == "home") : index-page := HomeForm {
        if (AppState.data.menu_id == "home" || AppState.data.menu_id == "album") : index-page := HomeForm { 
          height: parent.height - 14pt;
          visible: AppState.data.menu_id == "home" || AppState.data.menu_id == "album";
          navigate(menuid) => {
            AppState.data.menu_id = menuid;
            root.notify-changed();
            menu-changed(menuid);
          }
          open-web(link) => { root.open_web(link); }
          enable-vol: AppState.data.enable_vol;
        }

        if (AppState.data.menu_id == "volume") : Rectangle {
          background: #b0d0d0;
          // Volume Information
          // CustomTableViewPage { width: 100%; height: 100%; }
        }

        if (AppState.data.menu_id == "upload") : Rectangle {
          background: #202020;
          FileTable {
            width: 100%; height: 100%;

            row_data    : AppState.data.filelist;
            current_path: AppState.data.current_pth;

            synode-linked: AppState.data.synode_linked;

            init => { root.load_folder("."); }

            row-double-click(row) => {
              if (row.is-folder) {
                debug("[App Window] callback, loading: " + row.fname);
                root.load_folder(row.fullpath);
              }
            }

            row-selected(row) => {
              if (!row.is-folder) {
                debug("[App Window] callback, synching: " + row.fname);
                root.select_file(row, row.iselected);
              }
            }

            upload => { root.upload_files(); }
          }
        }

        if (AppState.data.menu_id == "2-1") : Rectangle {
          UserProfile { }
        }

        if (AppState.data.menu_id == "2-2") : Rectangle {
          background: #b0d0d0;
          EdgeHealth {
            width: 100%; height: 100%;
            echows-clicked(msg) => { root.echows(msg); }
            pingws-clicked => { root.pingws(self.file_paths)}
          }
        }

        status-bar:= HorizontalLayout {
          padding-top: 1pt;
          padding-left: 12pt;
          STag{ text: AppState.data.syncing_status;
            clicked => { popup.open(); }
          }
        }
      }
    }
  }

  popup:=SPopup {
    Rectangle {
      background: #222;
      VerticalLayout {
        padding: 12px;
        alignment: center;
        Text{ horizontal-alignment: left;
            color: #ddd;
            font-size: 12pt;
            text: AppState.data.syncing_status; }
      }
    }
  }
}
