import { SMenu, SCard, SHeader, SIcon, SButton, SPopup, STag } from "@surrealism/index.slint";
import { UseIcons } from "@surrealism/use/index.slint";

import { TableViewPage } from "./table_view_page.slint";
import { CustomTableViewPage } from "./custom-table.slint";
import { HomeForm } from "home.slint";
import { EdgeHealth } from "edge-health.slint";
import { PathItemData, FileTable } from "file-table.slint";
import { User } from "user.slint";
import { IDs, AppState } from "app-state.slint";

export { IDs, AppState, UserProfile } from "app-state.slint";

export component App inherits Window {

/* To enable slint preview, use this:
 */
height: 600px;
width: 1024px;

/* To enable maximize, use this:
preferred-height: 600px;
preferred-width:  1024px;
min-height: 400px;
min-width: 600px;
 */

  title: AppState.model.window_title;

  // Pure UI-computed outputs (window geometry read by the host) —
  // not part of AppState since the host only ever reads these, never sets them.
  out property <length> web_x;
  out property <length> web_y;
  out property <length> web_width;
  out property <length> web_height;

  // Design Notes:
  // Gemini says the callback cannot be reached because the callback hasn't been set by ui->on_initapp() yet.
  // callback initapp();

  callback menu-changed(string);
  callback item_clicked(string, bool);
  callback echows(string);
  callback pingws([string]);
  callback load_folder(string);
  callback query_syncflags();
  callback update_syncflags();
  callback select_file(PathItemData, bool);
  callback upload_files();
  callback open_web(string);
  callback open_volume();
  // callback update_synlink(bool);
  callback save_userinfo();

  function notify-changed() {
      AppState.model-changed(AppState.model);
  }

  init => { }

  HorizontalLayout {
    left-wrapper:=Rectangle {
      z: 111;
      width: menu.width;
      clip: false;
      menu:=SMenu {
        menu-data: [
          { id: IDs.m_home, icon: @image-url("imgs/home.svg"),  name: "Home" },
          { id: IDs.m_album,  icon: @image-url("imgs/album-icon.svg"), name: "Album"},
          { id: IDs.m_volume, icon: UseIcons.icons.Folder,   name: "Volume" },
          { id: IDs.m_upload, icon: UseIcons.icons.FileCode, name: "Upload" }
        ];

        
        sub-menu-data: [
          {id: IDs.m_user, icon:UseIcons.icons.Avatar,name:"User"},
          {id: IDs.m_edge, icon:UseIcons.icons.Setting-two,name:"Settings"}
        ];


        change(index, data) => {
          debug(index, data);
          AppState.model.menu_id = data.id;
          root.notify-changed();
          menu-changed(data.id);
        }
      }
    }

    right-wrapper:=Rectangle {
      z: 100;
      width: parent.width - menu.width;
      background: #2b2b32;
      VerticalLayout {
        width: parent.width;
        height: parent.height;

        // if (AppState.data.menu_id == "home") : index-page := HomeForm {
        if (AppState.model.menu_id == IDs.m_home || AppState.model.menu_id == IDs.m_album) : index-page := HomeForm { 
          height: parent.height - 14pt;
          visible: AppState.model.menu_id == IDs.m_home || AppState.model.menu_id == IDs.m_album;
          navigate(menuid) => {
            AppState.model.menu_id = menuid;
            root.notify-changed();
            menu-changed(menuid);
          }
          open-web(link) => { root.open_web(link); }
          enable-vol: AppState.model.enable_vol;
        }

        if (AppState.model.menu_id == IDs.m_volume) : Rectangle {
          background: #b0d0d0;
          // Volume Information
          // CustomTableViewPage { width: 100%; height: 100%; }
        }

        if (AppState.model.menu_id == IDs.m_upload) : Rectangle {
          background: #202020;
          FileTable {
            width: 100%; height: 100%;

            row_data    : AppState.model.filelist;
            current_path: AppState.model.current_pth;

            synode-linked: AppState.model.synode_linked;

            init => { root.load_folder("."); }

            row-double-click(row) => {
              if (row.is-folder) {
                debug("[App Window] callback, loading: " + row.fname);
                root.load_folder(row.fullpath);
              }
            }

            row-selected(row) => {
              if (!row.is-folder) {
                debug("[App Window] callback, synching: " + row.fname);
                root.select_file(row, row.iselected);
              }
            }

            upload => { root.upload_files(); }
          }
        }

        if (AppState.model.menu_id == IDs.m_user) : Rectangle {
          User {
            save-profile(jserv, u, p) => {
              root.save_userinfo();
              // debug("save-profile:", jserv, u, p, "=> save_userinfo()");
              debug("save-profile: => save_userinfo()");
            }
          }
        }

        if (AppState.model.menu_id == IDs.m_edge) : Rectangle {
          background: #b0d0d0;
          EdgeHealth {
            width: 100%; height: 100%;
            echows-clicked(msg) => { root.echows(msg); }
            pingws-clicked => { root.pingws(self.file_paths); }
          }
        }

        status-bar:= HorizontalLayout {
          padding-top: 1pt;
          padding-left: 12pt;
          STag{ text: AppState.model.syncing_status[0];
            clicked => { popup.open(); }
          }
        }
      }
    }
  }

  popup:=SPopup {
    Rectangle {
      background: #222;
      VerticalLayout {
        padding: 12px;
        alignment: center;
        // Text{ horizontal-alignment: left;
        //     color: #ddd;
        //     font-size: 12pt;
        //     text: AppState.model.syncing_status[0]; }
        
        for i in Math.min(15, AppState.model.syncing-status.length): Text {
            text: AppState.model.syncing-status[i];
            font-size: 14px;
            color: #333333;
        }
      }
    }
  }
}
